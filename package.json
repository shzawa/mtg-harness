{
  "name": "mtg-harness",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Google Meet の /meet/ で始まるページの誤った閉鎖を防ぐブラウザ拡張",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.node.json",
    "test": "npm run test:release && npm run build && npm run test:e2e",
    "test:release": "vitest run --project release",
    "test:e2e": "vitest run --project e2e",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "web-ext": "10.8.0",
    "wxt": "0.21.5"
  }
}
